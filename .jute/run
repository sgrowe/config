#!/bin/sh
set -e

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

os=$(uname -s)
arch=$(uname -m)

case "$os" in
  Darwin) os=macos ;;
  Linux)  os=linux ;;
  *)
    echo "jute: unsupported operating system: $os" >&2
    exit 1
    ;;
esac

case "$arch" in
  arm64 | aarch64) arch=aarch64 ;;
  x86_64 | amd64)  arch=x86_64 ;;
  *)
    echo "jute: unsupported architecture: $arch" >&2
    exit 1
    ;;
esac

bin="$dir/bin/jute-$os-$arch"

if [ ! -x "$bin" ]; then
  echo "jute: no binary for $os-$arch (looked for $bin)" >&2
  exit 1
fi

exec "$bin" "$@"
